# Production Environment Configuration Example
# Copy this file to .env or configure these variables in the Vercel Dashboard

# Flask Environment & Secrets
FLASK_ENV=production
SECRET_KEY=your-production-secret-key-at-least-32-chars-long
ALLOWED_ORIGINS=https://your-app-name.vercel.app,http://localhost:5173

# Temporary Upload & Storage Settings
UPLOAD_FOLDER=/tmp/uploads

# MySQL Cloud Database Configuration Options
# Option 1: Full connection URI (e.g. PlanetScale, AWS RDS, GCP Cloud SQL, Railway, Aiven)
MYSQL_URL=mysql+pymysql://username:password@mysql-host.example.com:3306/resume_db

# Option 2: Individual MySQL component variables
# MYSQL_USER=your_db_user
# MYSQL_PASSWORD=your_db_password
# MYSQL_HOST=your_db_host.example.com
# MYSQL_PORT=3306
# MYSQL_DB=resume_db

# Frontend Configuration
VITE_API_BASE_URL=/api
