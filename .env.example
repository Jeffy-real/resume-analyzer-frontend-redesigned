# Production Environment Configuration Example
# Copy this file to .env or configure these variables in the Vercel Dashboard

# Flask Environment & Secrets
FLASK_ENV=production
SECRET_KEY=your-production-secret-key-at-least-32-chars-long
ALLOWED_ORIGINS=https://your-app-name.vercel.app,http://localhost:5173

# Temporary Upload & Storage Settings
UPLOAD_FOLDER=/tmp/uploads
DATABASE_PATH=/tmp/resume_analyzer.db

# Database Connection (Optional - defaults to SQLite in /tmp)
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://user:password@host:3306/dbname

# Frontend Configuration
VITE_API_BASE_URL=/api
